<%- include('_head') %><div class="page-heading"><div><span class="eyebrow">CHĂM SÓC VÒNG ĐỜI THIẾT BỊ</span><h1>Lịch và lịch sử bảo trì</h1><p class="muted">Lên lịch, theo dõi thực hiện và lưu kết quả từng lần bảo trì.</p></div><a class="button" href="#schedule">＋ Lập lịch</a></div><section class="panel"><form class="filters" method="get"><label class="search">Từ khóa<input name="q" value="<%= q %>" placeholder="Thiết bị hoặc nội dung bảo trì..."></label><label>Trạng thái<select name="status"><option value="">Tất cả trạng thái</option><% for(const [key,label] of Object.entries(maintenanceStates)){ %><option value="<%= key %>" <%= status===key?'selected':'' %>><%= label %></option><% } %></select></label><button class="button">Lọc</button><a href="/maintenance" class="reset">Đặt lại</a></form><div class="list-summary"><strong><%= count %> phiếu bảo trì</strong><span class="muted">Lịch sử hoàn tất được giữ để đối chiếu</span></div><% if(!rows.length){ %><div class="empty">Chưa có phiếu phù hợp.</div><% } %><% for(const m of rows){ %><article class="maintenance-item"><div class="maintenance-title"><div><a href="/assets/<%= m.asset_id %>" class="eyebrow"><%= m.code %> · <%= m.name %></a><h3>BT-<%= String(m.id).padStart(4,'0') %> · <%= m.title %></h3><p class="muted">Dự kiến <%= date(m.scheduled_on) %> · <%= m.provider||'Chưa chỉ định đơn vị' %></p></div><div class="actions"><% if(m.overdue){ %><span class="badge late">Quá hạn</span><% } %><span class="badge <%= m.status %>"><%= maintenanceStates[m.status] %></span><% if(m.status==='scheduled'){ %><form method="post" action="/maintenance/<%= m.id %>/start"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="button secondary">Bắt đầu →</button></form><% } %></div></div><% if(m.status==='in_progress'){ %><form method="post" action="/maintenance/<%= m.id %>/complete" class="complete-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="grow">Kết quả thực hiện<input name="result" required maxlength="2000" placeholder="Mô tả công việc và kết quả..."></label><label>Chi phí (VND)<input name="cost_vnd" type="number" value="0" min="0" max="99999999999999" step="1" required></label><button class="button">Hoàn tất ✓</button></form><% } %><% if(['scheduled','in_progress'].includes(m.status)){ %><details class="cancel-details"><summary>Hủy phiếu bảo trì</summary><form method="post" action="/maintenance/<%= m.id %>/cancel" class="inline-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="result" placeholder="Lý do hủy" required maxlength="2000" aria-label="Lý do hủy"><button class="button danger">Xác nhận hủy</button></form></details><% }else{ %><p class="result-text"><%= m.result||'Chưa có ghi chú' %></p><p class="muted">Chi phí: <strong><%= money(m.cost_vnd) %></strong> · Kết thúc <%= date(m.finished_at) %></p><% } %></article><% } %><div class="pagination"><span>Trang <%= page %> / <%= pages %></span><div><% for(const target of [page-1,page+1]){ if(target>=1&&target<=pages){ %><a class="button secondary" href="/maintenance?<%= new URLSearchParams({status,q,page:target}) %>"><%= target<page?'← Trước':'Sau →' %></a><% }} %></div></div></section><section class="panel form-panel" id="schedule"><h2>Lập lịch bảo trì mới</h2><form method="post" action="/maintenance"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="form-grid"><label>Thiết bị *<select name="asset_id" required><% for(const a of assets){ %><option value="<%= a.id %>" <%= String(a.id)===String(selected)?'selected':'' %>><%= a.code %> · <%= a.name %></option><% } %></select></label><label>Nội dung bảo trì *<input name="title" required maxlength="160" placeholder="VD: Vệ sinh và kiểm tra định kỳ"></label><label>Ngày dự kiến *<input name="scheduled_on" type="date" required value="<%= isoDate(new Date()) %>"></label><label>Người / đơn vị thực hiện<input name="provider" maxlength="160" placeholder="VD: Tổ kỹ thuật ICTU"></label></div><div class="form-actions"><span class="muted">Thiết bị ngừng sử dụng không xuất hiện trong danh sách.</span><button class="button">Lưu lịch bảo trì →</button></div></form></section><%- include('_foot') %>
