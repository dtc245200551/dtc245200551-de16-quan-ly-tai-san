<%- include('_head') %><div class="page-heading"><div><span class="eyebrow">HỒ SƠ THIẾT BỊ</span><h1><%= title %></h1><p class="muted">Mã thiết bị và serial giúp phân biệt từng tài sản riêng lẻ.</p></div><a href="/assets" class="button secondary">← Danh sách</a></div><form method="post" action="/assets<%= asset.id?'/'+asset.id:'' %>" class="panel form-panel"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="version" value="<%= asset.version||1 %>"><h2>Thông tin cơ bản</h2><div class="form-grid"><label>Mã thiết bị *<input name="code" value="<%= asset.code||'' %>" required maxlength="40" pattern="[A-Za-z0-9][A-Za-z0-9_-]*" placeholder="VD: TB-013"></label><label>Tên thiết bị *<input name="name" value="<%= asset.name||'' %>" required maxlength="160"></label><label>Serial<input name="serial" value="<%= asset.serial||'' %>" maxlength="100"></label><label>Danh mục *<select name="category_id" required><% for(const c of categories){ %><option value="<%= c.id %>" <%= c.id===asset.category_id?'selected':'' %>><%= c.name %></option><% } %></select></label><label>Phòng ban / vị trí *<select name="location_id" required><% for(const l of locations){ %><option value="<%= l.id %>" <%= l.id===asset.location_id?'selected':'' %>><%= l.name %></option><% } %></select></label><label>Trạng thái *<select name="status"><% for(const [key,label] of Object.entries(assetStates)){ if(key==='maintenance'&&asset.status!=='maintenance')continue; %><option value="<%= key %>" <%= key===asset.status?'selected':'' %>><%= label %></option><% } %></select></label><label>Ngày mua<input name="purchased_on" type="date" value="<%= isoDate(asset.purchased_on) %>"></label><label>Giá trị thiết bị (VND)<input name="value_vnd" type="number" step="1" min="0" max="99999999999999" value="<%= asset.value_vnd %>" required></label><label class="full">Ghi chú<textarea name="notes" rows="4" maxlength="2000"><%= asset.notes||'' %></textarea></label></div><div class="form-actions"><span class="muted">* Thông tin bắt buộc</span><button class="button">Lưu thiết bị →</button></div></form><%- include('_foot') %>
