<%- include('_head') %><div class="page-heading"><div><span class="eyebrow">DANH SÁCH TẬP TRUNG</span><h1>Thiết bị</h1><p class="muted">Tra cứu và cập nhật hồ sơ tài sản của đơn vị.</p></div><a class="button" href="/assets/new">＋ Thêm thiết bị</a></div><section class="panel"><form class="filters" method="get"><label class="search">Từ khóa<input name="q" value="<%= filters.q %>" placeholder="Mã, tên hoặc serial..."></label><label>Trạng thái<select name="status"><option value="">Tất cả trạng thái</option><% for(const [key,label] of Object.entries(assetStates)){ %><option value="<%= key %>" <%= filters.status===key?'selected':'' %>><%= label %></option><% } %></select></label><label>Danh mục<select name="category"><option value="">Tất cả danh mục</option><% for(const c of categories){ %><option value="<%= c.id %>" <%= filters.category===String(c.id)?'selected':'' %>><%= c.name %></option><% } %></select></label><label>Vị trí<select name="location"><option value="">Tất cả vị trí</option><% for(const l of locations){ %><option value="<%= l.id %>" <%= filters.location===String(l.id)?'selected':'' %>><%= l.name %></option><% } %></select></label><button class="button">Lọc</button><a href="/assets" class="reset">Đặt lại</a></form><div class="list-summary"><strong><%= count %> thiết bị</strong><span class="muted">Theo mã thiết bị · 10 hồ sơ / trang</span></div><div class="table-wrap"><table><thead><tr><th>Mã / Thiết bị</th><th>Danh mục</th><th>Vị trí</th><th>Giá trị</th><th>Trạng thái</th><th></th></tr></thead><tbody><% for(const a of rows){ %><tr><td><a class="asset-name" href="/assets/<%= a.id %>"><span class="device-icon">▣</span><span><strong><%= a.name %></strong><small><%= a.code %> · <%= a.serial||'Chưa có serial' %></small></span></a></td><td><%= a.category %></td><td><%= a.location %></td><td class="nowrap"><%= money(a.value_vnd) %></td><td><span class="badge <%= a.status %>"><%= assetStates[a.status] %></span></td><td><a href="/assets/<%= a.id %>/edit">Sửa ↗</a></td></tr><% } %><% if(!rows.length){ %><tr><td colspan="6" class="empty">Không có thiết bị phù hợp với bộ lọc.</td></tr><% } %></tbody></table></div><div class="pagination"><span>Trang <%= page %> / <%= pages %></span><div><% for(const target of [page-1,page+1]){ if(target>=1&&target<=pages){ const qs=new URLSearchParams({...filters,page:target}); %><a class="button secondary" href="/assets?<%= qs %>"><%= target<page?'← Trước':'Sau →' %></a><% }} %></div></div></section><%- include('_foot') %>
