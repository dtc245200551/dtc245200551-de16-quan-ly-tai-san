<%- include('_head') %><div class="page-heading"><div><span class="eyebrow">BỨC TRANH THIẾT BỊ</span><h1>Tổng quan tài sản</h1><p class="muted">Nắm trạng thái thiết bị và những việc cần xử lý hôm nay.</p></div><a class="button" href="/assets/new">＋ Thêm thiết bị</a></div>
<div class="stats"><% for(const [key,label,icon] of [['total','Tổng thiết bị','▣'],['in_use','Đang sử dụng','↗'],['available','Sẵn sàng','✓'],['maintenance','Đang bảo trì','◷']]){ %><a href="/assets<%= key==='total'?'':'?status='+key %>" class="stat"><div><span><%= label %></span><b><%= stats[key] %></b><small><%= key==='total'?'Tất cả hồ sơ thiết bị':'Xem danh sách →' %></small></div><i class="stat-icon <%= key %>"><%= icon %></i></a><% } %></div>
<div class="dashboard-grid"><section class="panel"><div class="panel-heading"><div><h2>Lịch bảo trì sắp tới</h2><p class="muted">Ưu tiên xử lý các lịch đã đến hạn</p></div><a href="/maintenance">Xem tất cả →</a></div><% if(!due.length){ %><div class="empty">Chưa có lịch bảo trì đang chờ.</div><% } %><% for(const m of due){ %><a class="due-item" href="/maintenance?q=<%= encodeURIComponent(m.code) %>"><span class="calendar-icon"><%= date(m.scheduled_on).slice(0,5) %></span><div><strong><%= m.title %></strong><small><%= m.code %> · <%= m.name %></small></div><span class="badge <%= m.overdue?'late':'scheduled' %>"><%= m.overdue?'Quá hạn':'Đã lên lịch' %></span></a><% } %></section><section class="panel overview"><span class="eyebrow">QUẢN LÝ CHỦ ĐỘNG</span><h2>Thiết bị tốt.<br>Công việc thông suốt.</h2><p>Hồ sơ đầy đủ giúp bạn kiểm tra thiết bị, lên lịch bảo trì và đối chiếu lịch sử nhanh hơn.</p><a href="/maintenance" class="button light">Lập lịch bảo trì →</a><div class="overview-bottom"><span><b><%= stats.retired %></b> ngừng sử dụng</span><span>PostgreSQL<br>Hồ sơ được lưu trữ</span></div></section></div>
<section class="panel"><div class="panel-heading"><h2>Phiếu bảo trì gần đây</h2><a href="/maintenance">Mở lịch sử →</a></div><div class="table-wrap"><table><thead><tr><th>Phiếu</th><th>Thiết bị</th><th>Nội dung</th><th>Ngày dự kiến</th><th>Trạng thái</th></tr></thead><tbody><% for(const m of recent){ %><tr><td>BT-<%= String(m.id).padStart(4,'0') %></td><td><a href="/assets/<%= m.asset_id %>"><%= m.code %></a></td><td><%= m.title %></td><td><%= date(m.scheduled_on) %></td><td><span class="badge <%= m.status %>"><%= maintenanceStates[m.status] %></span></td></tr><% } %></tbody></table></div></section><%- include('_foot') %>
