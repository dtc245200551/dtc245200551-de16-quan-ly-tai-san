<%- include('_head') %><div class="page-heading"><div><span class="eyebrow"><%= asset.code %> / HỒ SƠ THIẾT BỊ</span><h1><%= asset.name %></h1><span class="badge <%= asset.status %>"><%= assetStates[asset.status] %></span></div><div class="actions"><a class="button secondary" href="/assets/<%= asset.id %>/edit">Sửa hồ sơ</a><% if(asset.status!=='retired'){ %><a class="button" href="/maintenance?asset=<%= asset.id %>">＋ Lập lịch bảo trì</a><% } %></div></div><section class="panel"><div class="panel-heading"><h2>Thông tin thiết bị</h2></div><dl class="details"><% for(const [label,value] of [['Serial',asset.serial||'Chưa khai báo'],['Danh mục',asset.category],['Phòng ban / vị trí',asset.location],['Ngày mua',date(asset.purchased_on)],['Giá trị',money(asset.value_vnd)],['Ghi chú',asset.notes||'Không có ghi chú']]){ %><div><dt><%= label %></dt><dd><%= value %></dd></div><% } %></dl></section><section class="panel"><div class="panel-heading"><h2>Lịch và lịch sử bảo trì</h2><span class="muted"><%= history.length %> phiếu</span></div><% if(!history.length){ %><div class="empty">Thiết bị chưa có lịch bảo trì.</div><% } %><% for(const m of history){ %><article class="history-item"><div><span class="badge <%= m.status %>"><%= maintenanceStates[m.status] %></span><h3><%= m.title %></h3><p class="muted">BT-<%= String(m.id).padStart(4,'0') %> · <%= date(m.scheduled_on) %> · <%= m.provider||'Chưa chỉ định đơn vị' %></p></div><div><strong><%= money(m.cost_vnd) %></strong><p class="result-text"><%= m.result||'Chưa có kết quả' %></p></div></article><% } %></section><%- include('_foot') %>
